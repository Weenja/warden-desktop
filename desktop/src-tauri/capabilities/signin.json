{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "signin",
  "description": "Sign-in and linked window: start a sign-in, read the UI state, open a browser's extension page, size and close itself, switch open at login.",
  "windows": [
    "signin"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-state",
    "allow-open-extension-page",
    "allow-sign-in-google",
    "allow-open-get-warden",
    "allow-send-email-code",
    "allow-verify-email-code",
    "allow-fit-window",
    "allow-close-signin",
    "allow-get-autostart",
    "allow-set-autostart"
  ]
}
