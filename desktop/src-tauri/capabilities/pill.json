{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "pill",
  "description": "Drain pill: read the UI state, size itself, Stop.",
  "windows": [
    "pill"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-state",
    "allow-pill-fit",
    "allow-pill-metrics",
    "allow-stop-draining"
  ]
}
