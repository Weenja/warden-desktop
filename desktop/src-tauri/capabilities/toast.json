{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "toast",
  "description": "Low battery toast: read the UI state, size and close itself.",
  "windows": [
    "toast"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-state",
    "allow-close-window",
    "allow-fit-window"
  ]
}
