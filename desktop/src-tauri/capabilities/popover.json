{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "popover",
  "description": "Menu bar popover: read the UI state, size itself, reopen sign-in, open a browser's extension page, open the picker and the quit confirm.",
  "windows": [
    "popover"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-state",
    "allow-open-extension-page",
    "allow-fit-window",
    "allow-open-signin",
    "allow-open-picker",
    "allow-open-quit"
  ]
}
