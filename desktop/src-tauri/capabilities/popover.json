{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "popover",
  "description": "Menu bar popover: read the UI state, size itself, reopen sign-in, quit.",
  "windows": ["popover"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-state",
    "allow-fit-window",
    "allow-open-signin",
    "allow-quit-warden"
  ]
}
