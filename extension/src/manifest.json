{
  "manifest_version": 3,
  "name": "Warden β",
  "short_name": "Warden β",
  "version": "0.1.0",
  "description": "Earn your screen time. Guarded sites drain the points you earn on your phone, and lock at 0.",
  "key": "",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "Warden",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/grey-16.png", "32": "icons/grey-32.png", "48": "icons/grey-48.png" }
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["tabs", "nativeMessaging", "idle", "alarms", "storage", "declarativeNetRequest", "webRequest", "scripting"],
  "host_permissions": ["https://kgsrczwqhqcjdbeanlhh.supabase.co/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "minimum_chrome_version": "120"
}
